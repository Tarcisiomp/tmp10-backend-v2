# TMP10 backend — variáveis de ambiente (Railway → Settings → Variables)
# NÃO coloque valores reais neste arquivo. Ele vai para o GitHub só como lista de nomes.

# ── Obrigatórias (o servidor não inicia sem elas) ──────────────────
SUPABASE_SERVICE_KEY=
ML_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Token das rotas de manutenção/admin. Mínimo 32 caracteres, aleatório.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ── Opcionais ──────────────────────────────────────────────────────
# enforce (padrão) = bloqueia rotas admin sem token | report = só registra no log
ADMIN_ROUTES_MODE=enforce
SUPABASE_URL=https://foshqdjgbcigggrcjtap.supabase.co
ML_CLIENT_ID=
ERP_URL=https://roaring-pixie-c02520.netlify.app
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=
PORT=3001
